# Copy this file to `.env` in the repository root and fill in the values. Never commit `.env`.
# The runner loads it with python-dotenv (tools/phase9/e9_roster.py, make_client).
# Only the keys below are read. A configuration whose key is empty fails at `check-clients`, before any paid call.

# First-party routes (the nine Google and OpenAI configurations of the roster)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# OpenRouter (Claude Haiku 4.5 pinned to the Anthropic upstream, DeepSeek V4 Flash pinned to Baidu,
# Qwen3 235B pinned to GMICloud; DECISION_LOG P9-8, P9-10 on main)
OPENROUTER_API_KEY=

# Direct Anthropic API. Not used by any roster configuration since P9-8; needed only if a direct-API
# Claude configuration is re-enabled in tools/phase9/e9_roster.py.
ANTHROPIC_API_KEY=
